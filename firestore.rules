
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "LnHTX5SsPpcRFTGYDnuLGBzSGDl2";
    }

    function validProduct() {
      return request.resource.data.keys().hasOnly([
          'name',
          'price',
          'category',
          'description',
          'published',
          'images',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.price <= 100000
        && request.resource.data.category in [
          'candles',
          'gypsum',
          'gifts'
        ]
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.published is bool
        && request.resource.data.images is list
        && request.resource.data.images.size() > 0
        && request.resource.data.images.size() <= 6;
    }

    match /products/{productId} {

      allow get, list: if isAdmin()
        || resource.data.published == true;

      allow create, update: if isAdmin()
        && validProduct();

      allow delete: if isAdmin();
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
